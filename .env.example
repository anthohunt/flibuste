# Réglages du serveur (tous facultatifs). Copier en `.env` pour les changer.
PORT=8787
# Dossier de la base SQLite (parties, scores, rapports)
DATA_DIR=./data
# Dossier du client web compilé, servi par le serveur (pnpm --filter @flibuste/web build)
WEB_DIST=./apps/web/dist
# Adresse publique du jeu (contrôle d'origine des connexions WebSocket)
PUBLIC_URL=http://localhost:8787
# Derrière un proxy de confiance (nginx, Traefik…) : mettre true
TRUST_PROXY=false
# Remontée des remarques des joueurs en tickets GitHub (facultatif : sans jeton, rien n'est envoyé)
GITHUB_REPO=
GITHUB_TOKEN=
# Client web, à la compilation : adresse publique, contact affiché sur l'écran d'accueil
VITE_SITE_URL=http://localhost:8787
VITE_CONTACT_EMAIL=
